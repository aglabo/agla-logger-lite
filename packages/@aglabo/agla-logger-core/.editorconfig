# sub repository
# root = true

# ─────────────────────────────
# Programming Language
# ─────────────────────────────
# TypeScript
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
tab_width = 2

# ─────────────────────────────
# Special Files (e.g. Dockerfile, LICENSE)
# ─────────────────────────────
# ignore files
[**/*ignore]
indent_style = space
indent_size = 2
tab_width = 2


# [Dockerfile]
# indent_style = space
# indent_size = 2
