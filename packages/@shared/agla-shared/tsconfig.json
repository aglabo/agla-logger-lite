{
  "extends": "../../../base/configs/tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    // directories
    "declarationDir": "./module",
    // "outDir": "./maps",
    "rootDir": "./",
    // aliases
    // "baseUrl": "./",
    "paths": {
      "#/*": [
        "./src/*",
        "./*"
      ],
      "#shared/*": [
        "./shared/*"
      ],
      "#tests/*": [
        "./tests/*"
      ]
    },
    // types
    // cache
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsbuild-cache/tsBuildInfo.json"
  }
}
